{
  "functions": [
    {
      "source": "functions",
      "codebase": "duty-time",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        ".env*",
        "tsconfig.json"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
